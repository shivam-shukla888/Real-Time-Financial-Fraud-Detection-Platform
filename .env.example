# Server Configuration
FRAUD_HOST=0.0.0.0
FRAUD_PORT=8010
FRAUD_DEBUG=False
FRAUD_ENVIRONMENT=production

# Scoring Weights & Thresholds
FRAUD_ML_WEIGHT=0.65
FRAUD_GRAPH_WEIGHT=0.35
FRAUD_HIGH_RISK_THRESHOLD=0.70
FRAUD_MEDIUM_RISK_THRESHOLD=0.40
FRAUD_GRAPH_OVERRIDE_THRESHOLD=0.85

# Streaming Backend ("local" or "kafka")
FRAUD_STREAMING_BACKEND=local
FRAUD_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FRAUD_REPLAY_SPEED_EVENTS_PER_SEC=3.0

# Security & CORS
FRAUD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Reproducibility
FRAUD_RANDOM_SEED=42
